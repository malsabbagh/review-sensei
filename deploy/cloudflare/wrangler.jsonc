{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "reviewsensei-github-app",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-16",
	"workers_dev": true,
	"preview_urls": true,
	"vars": {
		"PUBLIC_WORKFLOW_TAG": "v5"
	},
	"routes": [
		{
			"pattern": "github.reviewsensei.dev",
			"zone_name": "reviewsensei.dev",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"services": [
		{
			"binding": "SELF",
			"service": "reviewsensei-github-app"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"DeliveryLedger"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"BrokerLedger"
			]
		},
		{
			"tag": "v3",
			"deleted_classes": [
				"DeliveryLedger",
				"BrokerLedger"
			]
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": ["**/fixtures/*.yml"],
			"fallthrough": true
		}
	],
	"observability": {
		"redact_query_string": false,
		"logs": {
			"enabled": true
		},
		"traces": {
			"enabled": true
		}
	}
}
