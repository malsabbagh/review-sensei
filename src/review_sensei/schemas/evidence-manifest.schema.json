{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/evidence-manifest.schema.json",
  "title": "ReviewSensei authenticated partition reference manifest v1",
  "description": "The owning control record authenticates this manifest. Integrity digests do not authenticate producers. Runtime additionally enforces canonical bytes, aggregates, unique opaque identities, deadline and exact owner/snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "encoding",
    "binding",
    "item_count",
    "decoded_bytes",
    "sha256",
    "encoded_bytes",
    "parts"
  ],
  "properties": {
    "encoding": {
      "const": "partitioned-json-v1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "pull_request",
        "base_sha",
        "head_sha",
        "policy_digest",
        "configuration_digest",
        "generation",
        "producer",
        "purpose",
        "schema_version"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "maxLength": 256
        },
        "repository_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 2147483647
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "producer": {
          "type": "string",
          "pattern": "^(local-ledger|github-bot:[1-9][0-9]{0,18})$"
        },
        "purpose": {
          "enum": [
            "baseline",
            "human-inventory",
            "feedback",
            "evidence",
            "queue"
          ]
        },
        "schema_version": {
          "const": "1.0"
        }
      }
    },
    "item_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "decoded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "encoded_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "storage_id",
          "bytes",
          "sha256"
        ],
        "properties": {
          "storage_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
