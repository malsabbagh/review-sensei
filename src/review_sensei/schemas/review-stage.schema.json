{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/review-stage.schema.json",
  "title": "ReviewSensei review stage v1",
  "description": "Structural contract for one configured review stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "prompt_template", "outputs"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "prompt_template": {
      "type": "string",
      "minLength": 1
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["summary", "comments", "learning_proposals"]
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "category_ids": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    }
  },
  "not": {
    "required": ["categories", "category_ids"]
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "focus"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "learnings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "categories": {
                  "type": "array",
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                  }
                },
                "include_uncategorized": {
                  "type": "boolean"
                }
              }
            },
            "documents": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "include": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "exclude": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "name": "Summary stage",
      "outputs": ["summary"],
      "prompt_template": "Return JSON with a summary.\n{diff}"
    },
    {
      "name": "Comments stage",
      "category_ids": ["correctness", "security"],
      "outputs": ["comments"],
      "prompt_template": "Review categories:\n{review_categories}\n{diff}"
    }
  ]
}
