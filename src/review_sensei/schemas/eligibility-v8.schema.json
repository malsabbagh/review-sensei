{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/eligibility-v8.schema.json",
  "title": "Union-aware native publication eligibility v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "current",
    "native_union"
  ],
  "properties": {
    "schema_version": {
      "const": "8"
    },
    "current": {
      "type": "object",
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1",
            "2.0",
            "3",
            "4",
            "5",
            "6",
            "7"
          ]
        }
      }
    },
    "native_union": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "repository_id",
            "pull_request",
            "producer_id",
            "head_sha",
            "base_sha",
            "transaction_id",
            "result_sha256",
            "plan_sha256",
            "inline_count",
            "parts"
          ],
          "properties": {
            "schema_version": {
              "const": "native-review-union-v1"
            },
            "repository_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "pull_request": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "producer_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "transaction_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inline_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250
            },
            "parts": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "native_id",
                  "content_sha256",
                  "finding_count"
                ],
                "properties": {
                  "native_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "finding_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "repository_id",
            "pull_request",
            "producer_id",
            "head_sha",
            "base_sha",
            "transaction_id",
            "result_sha256",
            "plan_sha256",
            "inline_count",
            "parts",
            "reused_roots"
          ],
          "properties": {
            "schema_version": {
              "const": "native-review-union-v2"
            },
            "repository_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "pull_request": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "producer_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "head_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "transaction_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "result_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inline_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250
            },
            "parts": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "native_id",
                  "content_sha256",
                  "finding_count"
                ],
                "properties": {
                  "native_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  "content_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "finding_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  }
                }
              }
            },
            "reused_roots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instance",
                  "thread_id",
                  "comment_id",
                  "review_id",
                  "native_head_sha",
                  "body_sha256"
                ],
                "properties": {
                  "instance": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "thread_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "comment_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "review_id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9223372036854775807
                  },
                  "native_head_sha": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "body_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
