{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/review-round-decision.schema.json",
  "title": "ReviewSensei review-round admission decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "admit",
    "count_as_completed_round",
    "round_kind",
    "handoff",
    "handoff_reason",
    "may_emit_approve"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {
      "type": "string",
      "enum": ["legacy", "advisory", "merge-focused", "strict"]
    },
    "admit": {"type": "boolean"},
    "count_as_completed_round": {"type": "boolean"},
    "round_kind": {
      "type": "string",
      "enum": ["initial", "verification", "none"]
    },
    "handoff": {"type": "boolean"},
    "handoff_reason": {
      "type": ["string", "null"],
      "enum": [
        "failed-attempt-budget-exhausted",
        "no-progress",
        "incomplete-coverage",
        "unreviewed-head",
        "paused",
        null
      ]
    },
    "may_emit_approve": {"type": "boolean"}
  }
}
