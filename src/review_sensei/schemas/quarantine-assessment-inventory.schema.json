{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/quarantine-assessment-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessments"
  ],
  "properties": {
    "schema_version": {
      "const": "quarantine-assessment-inventory-v1"
    },
    "assessments": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance",
          "concern"
        ],
        "properties": {
          "instance": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "concern": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
