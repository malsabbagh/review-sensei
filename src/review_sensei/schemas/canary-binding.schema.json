{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/canary-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_sha256",
    "release",
    "workflow_commit",
    "evidence_kind",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "release": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "workflow_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "evidence_kind": {"enum": ["fixture-downstream", "operator-live"]},
    "status": {"enum": ["bound", "deferred-operator-only"]}
  }
}
