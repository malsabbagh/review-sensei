{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/checkpoint-evidence.schema.json",
  "title": "ReviewSensei diagnostic evidence (not publication authority) v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publishable",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "publishable": {
      "const": false
    },
    "result": {
      "$ref": "https://reviewsensei.dev/schemas/v1/review-result.schema.json"
    }
  }
}
