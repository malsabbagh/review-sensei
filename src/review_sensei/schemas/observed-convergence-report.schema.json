{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/observed-convergence-report.schema.json",
  "title": "ReviewSensei observed convergence evidence report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "events", "baseline_events", "command_events", "finding_metrics", "execution_metrics", "shadow_isolated", "evidence_identity", "approval_events", "cutover_status", "unmet_criteria", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"type": "string", "enum": ["advisory", "merge-focused", "strict"]},
    "events": {
      "description": "Observed attempts. The bound is a storage ceiling, not a review-count admission limit; sequences past the former 32-round validation bound serialize normally.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "provider_calls", "baseline_loaded", "publication_status", "handoff_reason", "approval_events"],
        "allOf": [
          {
            "if": {
              "properties": {"publication_status": {"const": "handoff"}},
              "required": ["publication_status"]
            },
            "else": {"properties": {"handoff_reason": {"type": "null"}}}
          }
        ],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 128},
          "provider_calls": {"type": "integer", "minimum": 0, "maximum": 32},
          "baseline_loaded": {"type": "boolean"},
          "publication_status": {"type": "string", "enum": ["published", "handoff", "disabled", "already_published"]},
          "handoff_reason": {
            "anyOf": [
              {"type": "string", "minLength": 1, "maxLength": 128},
              {"type": "null"}
            ]
          },
          "approval_events": {"type": "integer", "minimum": 0, "maximum": 32}
        }
      }
    },
    "baseline_events": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "command_events": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "finding_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_material_findings", "observed_material_findings", "matched_material_findings", "missed_material_findings", "unjustified_late_blockers", "blocker_precision", "seeded_material_regressions_detected", "duplicate_findings", "reopened_findings", "contradictions"],
      "properties": {
        "expected_material_findings": {"type": "integer", "minimum": 0, "maximum": 512},
        "observed_material_findings": {"type": "integer", "minimum": 0, "maximum": 512},
        "matched_material_findings": {"type": "integer", "minimum": 0, "maximum": 512},
        "missed_material_findings": {"type": "integer", "minimum": 0, "maximum": 512},
        "unjustified_late_blockers": {"type": "integer", "minimum": 0, "maximum": 512},
        "blocker_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "seeded_material_regressions_detected": {"type": "integer", "minimum": 0, "maximum": 512},
        "duplicate_findings": {"type": "integer", "minimum": 0, "maximum": 512},
        "reopened_findings": {"type": "integer", "minimum": 0, "maximum": 512},
        "contradictions": {"type": "integer", "minimum": 0, "maximum": 512}
      }
    },
    "execution_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_rounds", "handoffs", "provider_calls", "failed_attempts"],
      "properties": {
        "completed_rounds": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "handoffs": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "provider_calls": {"type": "integer", "minimum": 0, "maximum": 512},
        "failed_attempts": {"type": "integer", "minimum": 0, "maximum": 32}
      }
    },
    "shadow_isolated": {"type": "boolean"},
    "evidence_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_identity", "package_identity", "workflow_identity", "configuration_digest", "fixture_identity", "command"],
      "properties": {
        "source_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "package_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "workflow_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "configuration_digest": {"type": "string", "minLength": 1, "maxLength": 256},
        "fixture_identity": {"type": "string", "minLength": 1, "maxLength": 256},
        "command": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "approval_events": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
    "cutover_status": {"type": "string", "enum": ["passed", "not_ready"]},
    "unmet_criteria": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
  }
}
