{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/learning-entry.schema.json",
  "title": "ReviewSensei learning entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "rule", "scope"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {"type": "string", "minLength": 1},
    "rule": {"type": "string", "minLength": 1},
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["active", "retired"]}
  },
  "examples": [
    {
      "id": "architecture.provider-boundary",
      "title": "Provider boundary",
      "rule": "Keep provider transport and authentication under providers.",
      "scope": ["src/review_sensei/providers/**"],
      "rationale": "The core review engine stays provider-neutral.",
      "category": "architecture",
      "source": "docs/architecture.md",
      "status": "active"
    }
  ]
}
