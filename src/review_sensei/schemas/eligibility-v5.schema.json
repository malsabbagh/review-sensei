{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/eligibility-v5.schema.json",
  "title": "Default human inventory reference eligibility v5",
  "description": "Structural validation only. Requires an independently authenticated inventory reader, exact inventory/resolution binding, current transaction/root ownership and complete visible prose; references are not authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "head_sha",
    "result_digest",
    "facts",
    "human_inventory_reference",
    "human_resolution"
  ],
  "properties": {
    "schema_version": {
      "const": "5"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "result_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "enabled",
        "app_authored",
        "review_status",
        "evidence_policy",
        "has_blocking_findings",
        "has_human_adjudication_findings",
        "coverage_blocker",
        "qualification",
        "check_published"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "1",
            "2",
            "3"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "app_authored": {
          "type": "boolean"
        },
        "review_status": {
          "enum": [
            "complete",
            "partial",
            "incomplete",
            "summary-only"
          ]
        },
        "evidence_policy": {
          "enum": [
            "legacy",
            "confirmed"
          ]
        },
        "review_verdict": {
          "$ref": "https://reviewsensei.dev/schemas/v1/review-verdict.schema.json"
        },
        "has_blocking_findings": {
          "type": "boolean"
        },
        "has_human_adjudication_findings": {
          "type": "boolean"
        },
        "coverage_blocker": {
          "enum": [
            null,
            "reviewed",
            "partial",
            "incomplete",
            "unknown"
          ]
        },
        "qualification": {
          "enum": [
            "not-required",
            "qualified",
            "missing",
            "unverified"
          ]
        },
        "check_published": {
          "type": "boolean"
        },
        "persistence_status": {
          "const": "capacity-exceeded"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "qualification_binding": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "if": {
        "required": [
          "persistence_status"
        ]
      },
      "then": {
        "properties": {
          "review_status": {
            "const": "partial"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "2",
                  "3"
                ]
              }
            }
          },
          "then": {
            "required": [
              "provider"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "provider"
                  ]
                },
                {
                  "required": [
                    "qualification_binding"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "qualification_binding"
            ]
          },
          "then": {
            "properties": {
              "provider": {
                "const": "openrouter"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "3"
              }
            }
          },
          "then": {
            "required": [
              "review_verdict"
            ]
          },
          "else": {
            "not": {
              "required": [
                "review_verdict"
              ]
            }
          }
        }
      ]
    },
    "human_inventory_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "purpose",
        "event_key",
        "payload_digest"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "purpose": {
          "const": "default-human-inventory"
        },
        "event_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}\\t[a-f0-9]{64}$",
          "minLength": 129,
          "maxLength": 129
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "human_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "inventory_digest",
        "resolved"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "resolved": {
          "type": "array",
          "maxItems": 250,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "minLength": 64,
            "maxLength": 64
          }
        }
      }
    }
  }
}
