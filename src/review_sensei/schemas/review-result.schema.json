{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/review-result.schema.json",
  "title": "ReviewSensei review result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "comments", "provider"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "body"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "body": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "minLength": 1},
          "fix_effort": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"},
          "category": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "defect_kind": {"type": "string", "minLength": 1},
          "evidence_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider": {"type": "string", "minLength": 1},
    "review_status": {
      "type": "string",
      "enum": ["complete", "partial", "incomplete", "summary-only"]
    },
    "evidence_policy": {
      "type": "string",
      "enum": ["legacy", "confirmed"]
    },
    "coverage_mode": {
      "type": "string",
      "enum": ["full", "incremental", "fallback-full"]
    },
    "finding_lifecycles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "state"],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "type": "string",
            "enum": ["new", "still-present", "fixed", "outdated", "uncertain"]
          }
        }
      }
    },
    "model": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "learning_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "rule", "scope"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "complete",
        "snapshot",
        "languages",
        "excerpt_count",
        "outcomes"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "complete": {"type": "boolean"},
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "kind"],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "kind": {"type": "string", "const": "base"}
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "const": "python"}
        },
        "excerpt_count": {"type": "integer", "minimum": 0},
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1}
            }
          }
        },
        "untrusted_head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  }
}
