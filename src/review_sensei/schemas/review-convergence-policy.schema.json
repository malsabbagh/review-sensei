{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/review-convergence-policy.schema.json",
  "title": "ReviewSensei review-convergence policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "enforcement",
    "max_failed_attempts",
    "automatic_github_review_events",
    "inline_advisory_threads"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {
      "type": "string",
      "enum": ["legacy", "advisory", "merge-focused", "strict"]
    },
    "enforcement": {
      "type": "string",
      "enum": ["display-only", "publication"]
    },
    "max_failed_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "automatic_github_review_events": {"type": "boolean"},
    "inline_advisory_threads": {"type": "boolean"},
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
