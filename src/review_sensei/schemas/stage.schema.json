{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/stage.schema.json",
  "title": "ReviewSensei stage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "prompt_template", "outputs"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "prompt_template": {"type": "string", "minLength": 1},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["summary", "comments", "learning_proposals"]}
    },
    "categories": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewCategory"}
    },
    "category_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "reviewCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "focus"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "title": {"type": "string", "minLength": 1},
        "focus": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "learnings": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "categories": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1}
                },
                "include_uncategorized": {"type": "boolean"}
              }
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {
                  "path": {"type": "string", "minLength": 1},
                  "include": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "exclude": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1}
                  },
                  "required": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    }
  }
}
