{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/review-comment.schema.json",
  "title": "ReviewSensei review comment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["path", "body"],
  "properties": {
    "path": {"type": "string", "minLength": 1},
    "line": {"type": "integer", "minimum": 1},
    "body": {"type": "string", "minLength": 1},
    "side": {"type": "string", "enum": ["LEFT", "RIGHT", "FILE"]},
    "severity": {"type": "string", "minLength": 1},
    "fix_effort": {"type": "string", "minLength": 1},
    "blocking": {"type": "boolean"},
    "category": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "defect_kind": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "anyOf": [
        {"required": ["line"]},
        {
          "properties": {"side": {"const": "FILE"}},
          "required": ["side"]
        }
      ]
    },
    {
      "if": {
        "properties": {"side": {"const": "FILE"}},
        "required": ["side"]
      },
      "then": {
        "not": {"required": ["line"]}
      }
    }
  ]
}
