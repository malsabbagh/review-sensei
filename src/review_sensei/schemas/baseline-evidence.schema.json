{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cache_key",
    "policy_digest",
    "complete",
    "coverage_complete",
    "generation",
    "findings",
    "reviewed_paths",
    "related_paths"
  ],
  "properties": {
    "cache_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pull_request",
        "base_sha",
        "head_sha",
        "engine",
        "model",
        "profile",
        "stage_digest",
        "context_digest",
        "learning_digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 256
        },
        "pull_request": {
          "type": "integer",
          "minimum": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "engine": {
          "type": "string",
          "maxLength": 256
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "profile": {
          "type": "string",
          "maxLength": 256
        },
        "stage_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "learning_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "complete": {
      "type": "boolean"
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "findings": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "resolution_criterion",
          "concern",
          "path",
          "symbol",
          "defect_kind",
          "generation",
          "blocking"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "resolution_criterion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "concern": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "path": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 4096
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "defect_kind": {
            "type": "string",
            "maxLength": 256
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "reviewed_paths": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "related_paths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 4096
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/baseline-evidence.schema.json",
  "title": "Complete bounded baseline evidence"
}
