{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/api-run-accounting.schema.json",
  "title": "Current caller API request accounting values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "configuration",
    "owner",
    "startup",
    "startup_used",
    "prior_nonstartup_liability",
    "blocks",
    "completed",
    "version"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "run_id"
      ],
      "properties": {
        "repository_id": {
          "type": "integer",
          "minimum": 1
        },
        "run_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "digest",
        "limit"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slots"
      ],
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "job",
              "attempt",
              "requests"
            ],
            "properties": {
              "job": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
              },
              "attempt": {
                "type": "integer",
                "enum": [
                  1,
                  2
                ]
              },
              "requests": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
                },
                "minItems": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "startup_used": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      }
    },
    "prior_nonstartup_liability": {
      "type": "integer",
      "minimum": 0
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block_id",
          "issued_by",
          "undispatched",
          "pending"
        ],
        "properties": {
          "block_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "issued_by": {
            "$ref": "#/$defs/owner"
          },
          "undispatched": {
            "type": "integer",
            "minimum": 0
          },
          "pending": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/request"
            }
          }
        }
      }
    },
    "completed": {
      "type": "array"
    },
    "version": {
      "enum": [
        "caller-requests-v1",
        "caller-requests-v2"
      ]
    },
    "previous_record": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "root_sha256",
            "manifest"
          ],
          "properties": {
            "run_id": {
              "type": "integer",
              "minimum": 1
            },
            "root_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "manifest": {
              "$ref": "evidence-manifest.schema.json"
            }
          }
        }
      ]
    },
    "terminal_transaction": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "analysis_abort": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_root",
            "cleanup_root",
            "transaction",
            "entry_state",
            "run_id",
            "owner"
          ],
          "properties": {
            "source_root": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "cleanup_root": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "transaction": {
              "$ref": "review-transaction.schema.json"
            },
            "entry_state": {
              "const": "not_started"
            },
            "run_id": {
              "type": "integer",
              "minimum": 1
            },
            "owner": {
              "$ref": "#/$defs/owner"
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent",
            "phase",
            "execution_started",
            "result",
            "outcome"
          ],
          "properties": {
            "intent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "purpose",
                "source",
                "run_id",
                "owner",
                "head_sha",
                "configuration_digest",
                "operation_key",
                "source_root"
              ],
              "properties": {
                "purpose": {
                  "enum": [
                    "command",
                    "reply"
                  ]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "id",
                    "updated_at",
                    "body_sha256"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "issue_comment",
                        "review_comment"
                      ]
                    },
                    "id": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "updated_at": {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
                    },
                    "body_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                },
                "run_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "owner": {
                  "$ref": "#/$defs/owner"
                },
                "head_sha": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "configuration_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "operation_key": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_root": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "phase": {
              "enum": [
                "pending",
                "terminal"
              ]
            },
            "execution_started": {
              "type": "boolean"
            },
            "result": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "encoding",
                    "binding",
                    "item_count",
                    "sha256",
                    "document"
                  ],
                  "properties": {
                    "encoding": {
                      "const": "inline-json-v1"
                    },
                    "binding": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "repository",
                        "repository_id",
                        "pull_request",
                        "base_sha",
                        "head_sha",
                        "policy_digest",
                        "configuration_digest",
                        "generation",
                        "producer",
                        "purpose",
                        "schema_version"
                      ],
                      "properties": {
                        "repository": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
                          "maxLength": 256
                        },
                        "repository_id": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "pull_request": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 2147483647
                        },
                        "base_sha": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        },
                        "head_sha": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        },
                        "policy_digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "configuration_digest": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        },
                        "producer": {
                          "type": "string",
                          "pattern": "^(local-ledger|github-bot:[1-9][0-9]{0,18})$"
                        },
                        "purpose": {
                          "enum": [
                            "baseline",
                            "human-inventory",
                            "feedback",
                            "evidence",
                            "queue",
                            "dispositions"
                          ]
                        },
                        "schema_version": {
                          "const": "1.0"
                        }
                      }
                    },
                    "item_count": {
                      "type": "integer",
                      "const": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "document": {
                      "type": "object"
                    }
                  }
                }
              ]
            },
            "outcome": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "reason"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "applied",
                        "already_applied",
                        "explicit_noop"
                      ]
                    },
                    "reason": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "enum": [
                            "status",
                            "already_handled",
                            "policy_disabled",
                            "not_a_command",
                            "unauthorized",
                            "writes_disabled",
                            "not_mentioned",
                            "source_already_handled",
                            "no_change"
                          ]
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_attempt",
        "job",
        "generation"
      ],
      "properties": {
        "run_attempt": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "job": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "deadline_unix_ms"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "request-pair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "caller-requests-v1"
          }
        }
      },
      "then": {
        "properties": {
          "completed": {
            "items": {
              "$ref": "#/$defs/request"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": "caller-requests-v2"
          }
        }
      },
      "then": {
        "properties": {
          "completed": {
            "items": {
              "$ref": "#/$defs/request-pair"
            }
          }
        }
      }
    }
  ]
}
