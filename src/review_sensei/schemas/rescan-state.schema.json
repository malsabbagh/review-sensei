{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/rescan-state.schema.json",
  "title": "Explicit rescan replay watermarks and bounded audit receipts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_comment",
    "workflow_dispatch",
    "receipts"
  ],
  "properties": {
    "issue_comment": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "workflow_dispatch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "request_id",
          "review_id",
          "source",
          "ordinary_reservation",
          "reservation"
        ],
        "properties": {
          "mode": {
            "const": "remaining"
          },
          "kind": {
            "enum": [
              "issue_comment",
              "workflow_dispatch"
            ]
          },
          "request_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "review_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "source": {
            "$ref": "https://reviewsensei.dev/schemas/v1/review-transaction.schema.json"
          },
          "ordinary_reservation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          },
          "reservation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          },
          "progress": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "parent_digest",
              "child_digest",
              "execution_digest",
              "scope_digest",
              "inventory_digest",
              "reviewed_before_digest",
              "reviewed_after_digest",
              "schema_version",
              "reviewed_before",
              "reviewed_after"
            ],
            "properties": {
              "parent_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "child_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "execution_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "scope_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "inventory_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reviewed_before_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reviewed_after_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "schema_version": {
                "const": "1.0"
              },
              "reviewed_before": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "reviewed_after": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000
              }
            }
          }
        }
      }
    }
  }
}
