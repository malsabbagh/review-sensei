{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reviewsensei.dev/schemas/v1/rescan-state.schema.json",
  "title": "Explicit rescan replay watermarks and bounded audit receipts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_comment",
    "workflow_dispatch",
    "receipts"
  ],
  "properties": {
    "issue_comment": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "workflow_dispatch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "request_id",
          "review_id",
          "source",
          "ordinary_reservation",
          "reservation"
        ],
        "properties": {
          "kind": {
            "enum": [
              "issue_comment",
              "workflow_dispatch"
            ]
          },
          "request_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "review_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "source": {
            "$ref": "https://reviewsensei.dev/schemas/v1/review-transaction.schema.json"
          },
          "ordinary_reservation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          },
          "reservation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8,64}$"
          }
        }
      }
    }
  }
}
