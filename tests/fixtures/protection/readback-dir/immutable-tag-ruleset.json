{
  "id": 21068958,
  "name": "Immutable semantic version tags",
  "target": "tag",
  "source_type": "Repository",
  "source": "malsabbagh/review-sensei",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/v[0-9]*.[0-9]*.[0-9]*"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "update" },
    { "type": "required_signatures" }
  ],
  "bypass_actors": []
}
